# Frontend (públicas — podem ir para o navegador)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Servidor (função /api/colaboradores) — SECRETAS.
# Configure SOMENTE nas variáveis de ambiente da Vercel (ou em .env.local ao usar
# `vercel dev`). Nunca com prefixo VITE_ e nunca no código.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Endereço público do sistema; usado no link do e-mail de convite.
APP_URL=https://seu-projeto.vercel.app
